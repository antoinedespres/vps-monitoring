# Copy this file to .env and fill in the values.

# Discord Application → Bot → Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Target server/channel for alerts (right-click a channel in Discord with
# Developer Mode on -> Copy Server ID / Copy Channel ID). DISCORD_GUILD_ID is
# also where the slash commands get registered - leave it empty to run the
# bot as alerts-only, with no slash commands.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Name this VPS goes by in the slash-command embeds.
HOST_LABEL=vps

# Where docker-compose.yml bind-mounts the host root read-only. Only change
# this if you changed the mount; "/" means the bot is running outside a
# container and can read the host paths directly.
HOST_ROOT=/host

# SSH brute-force detection (via fail2ban)
FAIL2BAN_LOG=/var/log/fail2ban.log
FAIL2BAN_JAIL=sshd
SSH_PORT=22
SSH_AUTH_LOG=/var/log/auth.log

# HTTP brute-force detection (via Caddy access log)
CADDY_LOG=/var/log/caddy/access.log
MONITORED_HOST=home.example.com
HTTP_WINDOW_SECONDS=300
HTTP_WARN_THRESHOLD=30
HTTP_CRIT_THRESHOLD=100

# Brute-force SUCCESS detection: an accepted SSH login / HA login preceded by
# at least this many failures from the same IP within the correlation window.
LOGIN_CORRELATION_WINDOW_SECONDS=600
SSH_BRUTEFORCE_SUCCESS_THRESHOLD=3
HTTP_BRUTEFORCE_SUCCESS_THRESHOLD=3

# Comma-separated IPs (e.g. your home IP) that should never trigger a
# CRITICAL "brute-force SUCCEEDED" alert, even if they had a few failed
# attempts first (typos, retried connections) - downgraded to an info note.
TRUSTED_IPS=

# --- Installed-update reports ---------------------------------------------- #
# Post an embed listing what unattended-upgrades installed on this VPS (package
# names and old -> new versions), read back from the host's
# /var/log/apt/history.log. Set to 0 to turn the reports off.
REPORT_INSTALLED_UPDATES=1

# How often to look at that log. It is appended to about once a day, so there
# is no reason to check often.
INSTALLED_UPDATES_POLL_SECONDS=300

# unattended-upgrades installs in several small dpkg steps. A run is only
# reported once the log has been idle for this long, so one nightly run
# produces one embed instead of one per batch.
INSTALLED_UPDATES_SETTLE_SECONDS=180

# Where the bot remembers how far it has already reported. Backed by a Docker
# volume (see docker-compose.yml); if the path isn't writable the bot logs a
# warning and keeps running with in-memory state.
STATE_PATH=/var/lib/vps-monitoring/state.json
