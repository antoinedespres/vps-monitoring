# Copy this file to .env and fill in the values.

# Discord Application → Bot → Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Target server/channel for alerts (right-click a channel in Discord with
# Developer Mode on -> Copy Server ID / Copy Channel ID)
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# SSH brute-force detection (via fail2ban)
FAIL2BAN_LOG=/var/log/fail2ban.log
FAIL2BAN_JAIL=sshd
SSH_PORT=22
SSH_AUTH_LOG=/var/log/auth.log

# HTTP brute-force detection (via Caddy access log)
CADDY_LOG=/var/log/caddy/access.log
MONITORED_HOST=home.example.com
HTTP_WINDOW_SECONDS=300
HTTP_WARN_THRESHOLD=30
HTTP_CRIT_THRESHOLD=100

# Brute-force SUCCESS detection: an accepted SSH login / HA login preceded by
# at least this many failures from the same IP within the correlation window.
LOGIN_CORRELATION_WINDOW_SECONDS=600
SSH_BRUTEFORCE_SUCCESS_THRESHOLD=3
HTTP_BRUTEFORCE_SUCCESS_THRESHOLD=3

# Comma-separated IPs (e.g. your home IP) that should never trigger a
# CRITICAL "brute-force SUCCEEDED" alert, even if they had a few failed
# attempts first (typos, retried connections) - downgraded to an info note.
TRUSTED_IPS=
